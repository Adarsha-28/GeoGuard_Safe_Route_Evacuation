# GeoGuard V2 Environment Configuration
# Copy this file to .env and configure your values

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False

# PostgreSQL + PostGIS Connection String
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geoguard
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# External Services
# Project-OSRM Routing Service URL
OSRM_URL=https://router.project-osrm.org

# Open-Meteo API Endpoint (Free, no API key required)
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Request Timeout (in seconds)
HTTP_TIMEOUT=5.0

# Live Weather Synchronization Interval (in seconds, default 300 = 5 minutes)
WEATHER_SYNC_INTERVAL=300

# CORS Allowed Origins (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
